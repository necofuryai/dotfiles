    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "outputStyle": "Explanatory",
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1"
      ],
      "allowUnixSockets": [
        "{{ .chezmoi.homeDir }}/.gnupg/S.gpg-agent",
        "{{ .chezmoi.homeDir }}/.gnupg/S.gpg-agent.extra",
        "{{ .chezmoi.homeDir }}/.gnupg/S.gpg-agent.ssh",
        "{{ .chezmoi.homeDir }}/.gnupg/S.gpg-agent.browser",
        "{{ .chezmoi.homeDir }}/.gnupg/S.keyboxd",
        "{{ .chezmoi.homeDir }}/.gnupg/S.dirmngr"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "{{ .chezmoi.homeDir }}/.config/chezmoi",
        "{{ .chezmoi.homeDir }}/.gnupg",
        "{{ .chezmoi.homeDir }}/Library/pnpm"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git",
      "git *",
      "gpg",
      "gpg *",
      "gpgconf",
      "gpgconf *",
      "gpg-agent",
      "gpg-agent *",
      "mise",
      "mise *",
      "flutter",
      "flutter *",
      "dart",
      "dart *",
      "xcodebuild",
      "xcodebuild *",
      "swift",
      "swift *",
      "xcrun",
      "xcrun *",
      "pod",
      "pod *",
      "npm",
      "npm *",
      "npx",
      "npx *",
      "pnpm",
      "pnpm *",
      "gh",
      "gh *",

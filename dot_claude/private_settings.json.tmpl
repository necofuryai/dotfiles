      "pkill *",
      "sleep",
      "sleep *",
      "claude plugin",
      "claude plugin *"
    ]
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}

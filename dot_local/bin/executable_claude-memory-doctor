#!/usr/bin/env node
'use strict';

// Audit Claude Code auto-memory without printing memory contents or settings values.
// Claude Code v2.1.220 derives auto-memory from the Git repository root, while
// transcript storage remains tied to the session cwd. Keep those identities separate.
//
// --fix repairs unconfigured-stable-store by regenerating settings.local.json.
// The pointer is derived data: expectedStableDir() recomputes it from the repo
// identity, so a lost file is recreated instead of restored from a backup.

const crypto = require('crypto');
const fs = require('fs');
const os = require('os');
const path = require('path');
const { execFileSync } = require('child_process');

const userHome = os.homedir();
const configRoot = process.env.CLAUDE_CONFIG_DIR || path.join(userHome, '.claude');
const projectsRoot = path.join(configRoot, 'projects');
const claudeJsonPath = process.env.CLAUDE_CONFIG_DIR
  ? path.join(configRoot, '.claude.json')
  : path.join(userHome, '.claude.json');
const historyPath = path.join(configRoot, 'history.jsonl');

function readJson(file, fallback = {}) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return fallback;
  }
}

function realpathIfPossible(value) {
  try {
    return fs.realpathSync(value);
  } catch {
    return path.resolve(value);
  }
}

function git(cwd, args) {
  try {
    return execFileSync('git', ['-C', cwd, ...args], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return '';
  }
}

function projectRootFor(cwd) {
  const physicalCwd = realpathIfPossible(cwd);
  const top = git(physicalCwd, ['rev-parse', '--show-toplevel']);
  if (!top) return physicalCwd;

  const topReal = realpathIfPossible(top);
  const gitDir = git(physicalCwd, ['rev-parse', '--path-format=absolute', '--git-dir']);
  const commonDir = git(physicalCwd, ['rev-parse', '--path-format=absolute', '--git-common-dir']);
  if (!gitDir || !commonDir) return topReal;

  const gitDirReal = realpathIfPossible(gitDir);
  const commonReal = realpathIfPossible(commonDir);
  const linkedWorktreePrefix = `${commonReal}${path.sep}worktrees${path.sep}`;
  if (
    gitDirReal !== commonReal &&
    gitDirReal.startsWith(linkedWorktreePrefix) &&
    path.basename(commonReal) === '.git'
  ) {
    return realpathIfPossible(path.dirname(commonReal));
  }
  return topReal;
}

const stableStoreRoot = path.join(configRoot, 'project-memories');

// Mirrors the private stable-store convention: remote URL → <host>/<org>/<repo>,
// no remote → local/<basename>. Returns null when the repo identity is unclear.
function expectedStableDir(root) {
  let remote = git(root, ['remote', 'get-url', 'origin']);
  if (!remote) {
    const first = git(root, ['remote']).split('\n').filter(Boolean)[0];
    if (first) remote = git(root, ['remote', 'get-url', first]);
  }
  if (!remote) return path.join(stableStoreRoot, 'local', path.basename(root));
  let host;
  let repoPath;
  try {
    const url = new URL(remote);
    host = url.hostname;
    repoPath = url.pathname;
  } catch {
    const scp = remote.match(/^(?:[^@]+@)?([^:/]+):(.+)$/);
    if (scp) {
      host = scp[1];
      repoPath = scp[2];
    }
  }
  if (!host || !repoPath) return null;
  repoPath = repoPath.replace(/^\/+/, '').replace(/\.git$/, '').replace(/\/+$/, '');
  if (!repoPath) return null;
  return path.join(stableStoreRoot, host, repoPath);
}

// Matches Claude Code v2.1.220's path slug function, including the >200-char suffix.
function slugify(value) {
  const sanitized = value.replace(/[^a-zA-Z0-9]/g, '-');
  if (sanitized.length <= 200) return sanitized;
  let hash = 0;
  for (let i = 0; i < value.length; i++) {
    hash = ((hash << 5) - hash + value.charCodeAt(i)) | 0;
  }
  return `${sanitized.slice(0, 200)}-${Math.abs(hash).toString(36)}`;
}

function expandHome(value) {
  if (value === '~') return userHome;
  if (value.startsWith('~/')) return path.join(userHome, value.slice(2));
  return path.resolve(value);
}

function mdFiles(dir) {
  try {
    return fs.readdirSync(dir).filter((name) => name.endsWith('.md')).sort();
  } catch {
    return [];
  }
}

function sha256(file) {
  return crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
}

function sameFile(a, b) {
  try {
    return fs.statSync(a).size === fs.statSync(b).size && sha256(a) === sha256(b);
  } catch {
    return false;
  }
}

let knownBucketPathsCache;
function knownBucketPaths() {
  if (knownBucketPathsCache) return knownBucketPathsCache;
  const result = new Map();
  const add = (projectPath) => {
    if (typeof projectPath !== "string" || !projectPath.startsWith("/")) return;
    const bucket = slugify(projectPath);
    if (!result.has(bucket)) result.set(bucket, new Set());
    result.get(bucket).add(projectPath);
  };

  const config = readJson(claudeJsonPath);
  for (const projectPath of Object.keys(config.projects || {})) add(projectPath);
  try {
    for (const line of fs.readFileSync(historyPath, "utf8").split("\n")) {
      try {
        add(JSON.parse(line).project);
      } catch {
        // Preserve audit availability even if one history line is malformed.
      }
    }
  } catch {
    // history.jsonl is optional.
  }
  knownBucketPathsCache = result;
  return result;
}

function projectTrust(root) {
  const config = readJson(claudeJsonPath);
  return config.projects?.[root]?.hasTrustDialogAccepted === true;
}

function effectiveSettings(root, trust) {
  const userFile = path.join(configRoot, 'settings.json');
  const projectFile = path.join(root, '.claude', 'settings.json');
  const localFile = path.join(root, '.claude', 'settings.local.json');
  const layers = [{ scope: 'user', file: userFile, values: readJson(userFile) }];
  if (trust) {
    layers.push({ scope: 'project', file: projectFile, values: readJson(projectFile) });
    layers.push({ scope: 'local', file: localFile, values: readJson(localFile) });
  }

  function resolve(key, fallback) {
    let found = { value: fallback, scope: 'default', file: null };
    for (const layer of layers) {
      if (Object.prototype.hasOwnProperty.call(layer.values, key)) {
        found = { value: layer.values[key], scope: layer.scope, file: layer.file };
      }
    }
    return found;
  }

  const configuredWithoutTrust = [projectFile, localFile]
    .map((file) => ({ file, values: readJson(file) }))
    .find(({ values }) => Object.prototype.hasOwnProperty.call(values, 'autoMemoryDirectory'));

  return {
    trust,
    enabled: resolve('autoMemoryEnabled', true),
    directory: resolve('autoMemoryDirectory', null),
    configuredWithoutTrust,
  };
}

function inspectIndex(memoryDir, issues) {
  const files = mdFiles(memoryDir);
  if (!files.length) return { files, links: [] };

  const indexPath = path.join(memoryDir, 'MEMORY.md');
  if (!fs.existsSync(indexPath)) {
    issues.push({
      code: 'missing-index',
      message: `${memoryDir} に topic file はありますが MEMORY.md がありません`,
    });
    return { files, links: [] };
  }

  const index = fs.readFileSync(indexPath, 'utf8');
  const links = [...index.matchAll(/\]\(([^)]+\.md)\)/g)].map((match) => match[1]);
  for (const target of new Set(links)) {
    if (!fs.existsSync(path.join(memoryDir, target))) {
      issues.push({
        code: 'broken-index-link',
        message: `MEMORY.md が存在しない ${target} を参照しています`,
      });
    }
  }

  const indexed = new Set(links);
  for (const file of files) {
    if (file !== 'MEMORY.md' && !indexed.has(file)) {
      issues.push({
        code: 'unindexed-topic',
        message: `${file} が MEMORY.md の索引にありません`,
      });
    }
  }

  const lineCount = index.split('\n').length;
  const byteCount = Buffer.byteLength(index);
  if (lineCount > 200 || byteCount > 25 * 1024) {
    issues.push({
      code: 'index-over-limit',
      message: `MEMORY.md が起動時読込上限を超えています (${lineCount} lines / ${byteCount} bytes)`,
    });
  }
  return { files, links };
}

function inspectProject(inputPath) {
  const cwd = realpathIfPossible(inputPath);
  const root = projectRootFor(cwd);
  const checkoutRoot = realpathIfPossible(git(cwd, ['rev-parse', '--show-toplevel']) || root);
  const slug = slugify(root);
  const defaultDir = path.join(projectsRoot, slug, 'memory');
  const trust = projectTrust(checkoutRoot) || projectTrust(root);
  const settings = effectiveSettings(root, trust);
  const issues = [];

  const stalePaths = [...knownBucketPaths().values()]
    .flatMap((paths) => [...paths])
    .filter(
      (candidate) =>
        candidate !== root &&
        !fs.existsSync(candidate) &&
        path.basename(candidate) === path.basename(root),
    );
  for (const stalePath of new Set(stalePaths)) {
    issues.push({
      code: "orphaned-project-state",
      message: `消滅した旧パス ${stalePath} の Claude Code state が残っています`,
    });
  }

  if (!settings.trust && settings.configuredWithoutTrust) {
    issues.push({
      code: 'untrusted-override',
      message: `${settings.configuredWithoutTrust.file} の autoMemoryDirectory は workspace trust 未承認のため無効です`,
    });
  }

  const disabledByEnv = process.env.CLAUDE_CODE_DISABLE_AUTO_MEMORY === '1';
  const enabled = settings.enabled.value !== false && !disabledByEnv;
  const custom = typeof settings.directory.value === 'string' && settings.directory.value.length > 0;
  const customIsAbsolute =
    custom &&
    (settings.directory.value.startsWith('/') || settings.directory.value.startsWith('~/'));
  if (custom && !customIsAbsolute) {
    issues.push({
      code: 'invalid-memory-directory',
      message: 'autoMemoryDirectory は絶対パスまたは ~/ で始める必要があります',
    });
  }
  // A stable store that exists but is not wired up (fresh clone, lost
  // settings.local.json) silently falls back to the path-keyed default store.
  // Suppress only while trust is pending on a configured override, where
  // untrusted-override already reports the cause; a trusted project whose
  // value is degenerate (null/empty) is still effectively unconfigured.
  if (enabled && !custom && (settings.trust || !settings.configuredWithoutTrust)) {
    const expected = expectedStableDir(root);
    if (expected && mdFiles(expected).length) {
      issues.push({
        code: 'unconfigured-stable-store',
        message: `安定ストア ${expected} が存在しますが autoMemoryDirectory が未設定です (settings.local.json の消失や再クローン?)`,
      });
    }
  }

  const memoryDir = customIsAbsolute ? expandHome(settings.directory.value) : defaultDir;
  const inspected = enabled ? inspectIndex(memoryDir, issues) : { files: [], links: [] };

  // A configured stable directory must contain every old default-memory file.
  // Keeping identical default files as rollback copies is fine; only missing or
  // divergent files indicate a split store.
  if (enabled && customIsAbsolute && path.resolve(memoryDir) !== path.resolve(defaultDir)) {
    for (const file of mdFiles(defaultDir)) {
      const oldFile = path.join(defaultDir, file);
      const activeFile = path.join(memoryDir, file);
      if (!fs.existsSync(activeFile)) {
        issues.push({
          code: 'unmigrated-default-memory',
          message: `旧 default store の ${file} が固定保存先へ移行されていません`,
        });
      } else if (!sameFile(oldFile, activeFile) && file !== 'MEMORY.md') {
        issues.push({
          code: 'diverged-default-memory',
          message: `旧 default store と固定保存先の ${file} が分岐しています`,
        });
      } else if (file === 'MEMORY.md' && !sameFile(oldFile, activeFile)) {
        const activeLines = fs.readFileSync(activeFile, 'utf8').split('\n').filter((line) => line.trim());
        const activeTargets = new Set(
          activeLines.map((line) => line.match(/\]\(([^)]+)\)/)?.[1]).filter(Boolean),
        );
        const activePlainLines = new Set(
          activeLines.filter((line) => !line.match(/\]\(([^)]+)\)/)),
        );
        const missingIndexLine = fs
          .readFileSync(oldFile, 'utf8')
          .split('\n')
          .filter((line) => line.trim())
          .find((line) => {
            const target = line.match(/\]\(([^)]+)\)/)?.[1];
            return target ? !activeTargets.has(target) : !activePlainLines.has(line);
          });
        if (missingIndexLine) {
          issues.push({
            code: 'diverged-default-index',
            message: '旧 default store の MEMORY.md に固定保存先へ未統合の項目があります',
          });
        }
      }
    }
  }

  // Before worktree/subdirectory sharing, Claude Code could leave memory below
  // a cwd-derived child bucket. It is invisible to current repo-root memory.
  if (enabled && fs.existsSync(projectsRoot)) {
    const prefix = `${slug}-`;
    for (const bucket of fs.readdirSync(projectsRoot)) {
      if (!bucket.startsWith(prefix)) continue;
      const candidates = [...(knownBucketPaths().get(bucket) || [])].filter((candidate) =>
        fs.existsSync(candidate),
      );
      if (!candidates.some((candidate) => projectRootFor(candidate) === root)) continue;
      const legacyDir = path.join(projectsRoot, bucket, 'memory');
      for (const file of mdFiles(legacyDir)) {
        if (file === 'MEMORY.md') continue;
        const legacyFile = path.join(legacyDir, file);
        const activeFile = path.join(memoryDir, file);
        if (!fs.existsSync(activeFile) || !sameFile(legacyFile, activeFile)) {
          issues.push({
            code: 'legacy-child-memory',
            message: `${bucket}/memory/${file} は現行の Git-root memory から参照できません`,
          });
        }
      }
    }
  }

  return {
    cwd,
    root,
    slug,
    trust: settings.trust,
    enabled,
    source: settings.directory.scope,
    memoryDir,
    defaultDir,
    memoryFiles: inspected.files.length,
    issues,
  };
}

// Repair unconfigured-stable-store only. Every other issue either needs human
// judgment (diverged stores) or has a distinct cause reported separately.
// Requires accepted trust: a settings.local.json written into an untrusted
// project would sit dormant and surprise the user when trust is granted later.
function tryFixUnconfiguredStableStore(result) {
  if (!result.issues.some((issue) => issue.code === 'unconfigured-stable-store')) return null;
  const file = path.join(result.root, '.claude', 'settings.local.json');
  if (!result.trust) {
    return { file, applied: false, reason: 'workspace trust 未承認のため settings.local.json を書きません' };
  }
  if (!fs.existsSync(result.root)) {
    return { file, applied: false, reason: 'project root が存在しないためディレクトリを作りません' };
  }
  const expected = expectedStableDir(result.root);
  if (!expected || !mdFiles(expected).length) return null;

  // local/<basename> stores carry no ownership metadata: a same-named live
  // project elsewhere may own this store, and auto-wiring it here would read
  // and pollute another project's memory. Refuse and leave it to the user.
  if (expected === path.join(stableStoreRoot, 'local', path.basename(result.root))) {
    const rival = [...knownBucketPaths().values()]
      .flatMap((paths) => [...paths])
      .find(
        (candidate) =>
          path.basename(candidate) === path.basename(result.root) &&
          realpathIfPossible(candidate) !== result.root &&
          fs.existsSync(candidate),
      );
    if (rival) {
      return {
        file,
        applied: false,
        reason: `安定ストア local/${path.basename(result.root)} は同名の別プロジェクト ${rival} のものである可能性があるため自動修復を中止しました`,
      };
    }
  }

  let settings = {};
  let existingStat = null;
  try {
    existingStat = fs.lstatSync(file);
  } catch {}
  if (existingStat?.isSymbolicLink()) {
    return {
      file,
      applied: false,
      reason: 'settings.local.json が symlink (dotfiles 管理?) のため、リンク先への手動追記に委ねます',
    };
  }
  if (existingStat) {
    try {
      settings = JSON.parse(fs.readFileSync(file, 'utf8'));
    } catch {
      settings = null;
    }
    if (typeof settings !== 'object' || settings === null || Array.isArray(settings)) {
      return {
        file,
        applied: false,
        reason: '既存の settings.local.json が JSON オブジェクトとして読めないため自動修復を中止しました',
      };
    }
  }

  const value = expected.startsWith(userHome + path.sep)
    ? `~${expected.slice(userHome.length)}`
    : expected;
  settings.autoMemoryDirectory = value;
  const tmp = `${file}.tmp.${process.pid}`;
  try {
    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(tmp, `${JSON.stringify(settings, null, 2)}\n`);
    fs.renameSync(tmp, file);
  } catch (error) {
    try {
      fs.rmSync(tmp, { force: true });
    } catch {}
    return { file, applied: false, reason: `書き込みに失敗しました: ${error.message}` };
  }
  return { file, applied: true, value };
}

function humanReport(result) {
  console.log(`project root : ${result.root}`);
  console.log(`memory dir   : ${result.memoryDir}`);
  console.log(`settings     : ${result.source}${result.trust ? ' / trusted' : ' / untrusted'}`);
  console.log(`memory files : ${result.memoryFiles}`);
  for (const fix of result.fixes || []) {
    console.log(
      fix.applied
        ? `fixed        : autoMemoryDirectory → ${fix.value}`
        : `fix skipped  : ${fix.reason}`,
    );
  }
  if (!result.enabled) {
    console.log('status       : auto memory disabled');
    return;
  }
  if (!result.issues.length) {
    console.log('status       : OK');
    return;
  }
  console.log('status       : ERROR');
  for (const issue of result.issues) console.log(`- [${issue.code}] ${issue.message}`);
}

const args = process.argv.slice(2);
const hookMode = args.includes('--hook');
const jsonMode = args.includes('--json');
const allMode = args.includes('--all');
const fixMode = args.includes('--fix');
const positional = args.filter((arg) => !arg.startsWith('-'));

if (args.includes('--help')) {
  console.log('usage: claude-memory-doctor [--json] [--fix] [path]');
  console.log('       claude-memory-doctor --all [--json] [--fix]');
  console.log('       claude-memory-doctor --hook [--fix] [path]');
  console.log('');
  console.log('--fix: unconfigured-stable-store 検出時に settings.local.json を再生成する');
  process.exit(0);
}

let hookInput = {};
if (hookMode && !process.stdin.isTTY) {
  try {
    const raw = fs.readFileSync(0, 'utf8');
    hookInput = raw.trim() ? JSON.parse(raw) : {};
  } catch {
    hookInput = {};
  }
}

let targets;
// Hook mode always audits the session's own project: honoring --all here
// would fix and report an unrelated, alphabetically-first project.
if (allMode && !hookMode) {
  const config = readJson(claudeJsonPath);
  targets = Object.keys(config.projects || {}).filter((project) => fs.existsSync(project));
} else {
  targets = [positional[0] || hookInput.cwd || process.cwd()];
}

// uniqueRoots keeps the LAST result per root (the pre --fix semantics some
// trust/cwd fields depend on); the fix runs at most once per root, memoized
// separately so a later duplicate target does not drop the fix report.
const uniqueRoots = new Map();
const fixByRoot = new Map();
for (const target of targets) {
  let result = inspectProject(target);
  if (fixMode && !fixByRoot.has(result.root)) {
    fixByRoot.set(result.root, tryFixUnconfiguredStableStore(result));
    if (fixByRoot.get(result.root)?.applied) result = inspectProject(target);
  }
  const fix = fixByRoot.get(result.root);
  if (fix) result.fixes = [fix];
  uniqueRoots.set(result.root, result);
}
const results = [...uniqueRoots.values()].sort((a, b) => a.root.localeCompare(b.root));
const issueCount = results.reduce((sum, result) => sum + result.issues.length, 0);

if (hookMode) {
  const current = results[0];
  const lines = [];
  for (const fix of current?.fixes || []) {
    lines.push(
      fix.applied
        ? `🔧 auto-memory の保存先を自動修復しました: autoMemoryDirectory → ${fix.value}`
        : `⚠️ auto-memory の自動修復をスキップしました: ${fix.reason}`,
    );
  }
  if (current?.issues.length) {
    lines.push('⚠️ Claude Code auto-memory の保存先に問題があります。');
    lines.push(...current.issues.slice(0, 5).map((issue) => `- ${issue.message}`));
    lines.push(`確認: claude-memory-doctor ${JSON.stringify(current.cwd)}`);
  }
  if (lines.length) {
    process.stdout.write(
      JSON.stringify({
        hookSpecificOutput: {
          hookEventName: 'SessionStart',
          additionalContext: lines.join('\n'),
        },
      }) + '\n',
    );
  }
} else if (jsonMode) {
  console.log(JSON.stringify(results, null, 2));
} else {
  results.forEach((result, index) => {
    if (index) console.log('');
    humanReport(result);
  });
}

// Hooks must exit 0: Claude Code parses hookSpecificOutput JSON only on a
// clean exit; non-zero would discard the notification as a hook error.
process.exitCode = hookMode ? 0 : issueCount ? 1 : 0;

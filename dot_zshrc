# ============================================
# .zshrc — consolidated zsh config (macOS)
# ============================================

typeset -U path PATH fpath FPATH

# Homebrew env: login shells get this from .zprofile;
# this fallback covers non-login interactive shells
if [[ -z "$HOMEBREW_PREFIX" && -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# --------------------------------------------
# Environment Variables
# --------------------------------------------
export LANG=en_US.UTF-8
export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE=~/.zsh_history
export GPG_TTY=$(tty)
export EDITOR=nvim

if command -v nvim &>/dev/null; then
  export MANPAGER="nvim +Man!"
else
  export MANPAGER="col -b -x|vim -R -c 'set ft=man nolist nomod noma' -"
fi

export PNPM_HOME="$HOME/Library/pnpm"
export GOPATH="$HOME/go"

# --------------------------------------------
# PATH
# --------------------------------------------
# codex is ~/.local/bin/codex (on PATH via .zshenv), a chezmoi-managed link
# into the CLI bundled with ChatGPT.app; the Homebrew codex cask is
# intentionally not installed
path=(
  "$HOME/.bun/bin"
  /opt/homebrew/opt/mysql-client/bin
  /opt/homebrew/opt/rustup/bin
  $path
)

# --------------------------------------------
# Zsh Options
# --------------------------------------------
setopt auto_cd
setopt auto_menu
setopt auto_list
setopt list_packed
setopt hist_ignore_dups
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt share_history
setopt complete_in_word
setopt nonomatch
setopt RM_STAR_SILENT

ZLE_REMOVE_SUFFIX_CHARS=$''

# --------------------------------------------
# Completion System
# --------------------------------------------
autoload -Uz colors && colors

# fpath must be complete before compinit; Homebrew ships
# _kubectl, _gh, _docker, etc. in site-functions. bun comes from mise,
# so its _bun is not there and is sourced from ~/.bun/_bun at the end
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  fpath=(
    "$HOMEBREW_PREFIX/share/zsh/site-functions"
    "$HOMEBREW_PREFIX/share/zsh-completions"
    $fpath
  )
fi

autoload -Uz compinit && compinit

zstyle ":completion:*:commands" rehash 1
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path ~/.zsh/cache
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%B%F{green}[%d]%f%b'
zstyle ':completion:*:processes' command 'ps -au$USER'

alias k=kubectl
command -v kubectl &>/dev/null && compdef k=kubectl

# --------------------------------------------
# Functions
# --------------------------------------------
tgz() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: tgz DIST SOURCE"
    return 1
  fi
  xattr -rc "${@:2}" && \
  env COPYFILE_DISABLE=1 tar zcvf "$1" --exclude=".DS_Store" "${@:2}"
}

# --------------------------------------------
# Aliases
# --------------------------------------------
if command -v eza &>/dev/null; then
  alias ls='eza --group-directories-first'
  alias tree='eza --tree'
else
  alias ls='ls -G'
fi

alias grep='grep --color=auto'

if command -v nvim &>/dev/null; then
  alias vim='nvim'
  alias vi='nvim'
fi

# --------------------------------------------
# Homebrew Bundle Sync
# --------------------------------------------
if command -v brew &>/dev/null; then
  # No leading `_`: Claude Code's shell snapshot drops `_` functions, which
  # would leave brew() and brewup() calling a missing helper there.
  update_brewfile() {
    command brew bundle dump --force --tap --formula --cask --file="$HOME/.Brewfile" || return
    echo "Brewfile updated"
    if command -v chezmoi &>/dev/null; then
      chezmoi add "$HOME/.Brewfile" || return
      echo "Synced to chezmoi"
    fi
  }

  brew() {
    command brew "$@"
    local exit_code=$?
    case "$1" in
      install|uninstall|remove|tap|untap)
        [[ $exit_code -eq 0 ]] && update_brewfile
        ;;
    esac
    return $exit_code
  }

  brewup() {
    brew update && \
      brew upgrade --greedy --no-ask && \
      brew autoremove && \
      brew cleanup && \
      brew doctor || return

    update_brewfile || return

    if ! command -v chezmoi &>/dev/null; then
      echo "chezmoi not found; skipping Brewfile staging" >&2
      return
    fi

    local brewfile_source
    brewfile_source="$(chezmoi source-path "$HOME/.Brewfile")" || return

    chezmoi git -- add -- "$brewfile_source" || return

    local staged_brewfile
    staged_brewfile="$(chezmoi git -- diff --cached --name-only -- "$brewfile_source")" || return
    if [[ -n "$staged_brewfile" ]]; then
      echo "Brewfile staged. Review with: chezmoi git -- diff --cached -- dot_Brewfile"
      echo "Commit and push manually after review."
    fi
  }
fi

# --------------------------------------------
# gsd Self-Update Guard
# --------------------------------------------
# gsd is pinned in ~/.config/mise/config.toml. Its self-update runs
# `npm install -g`, which lands in mise's node prefix and shadows the pin.
# `update --models` only refreshes the model catalog, so it passes.
# Not covered: `/gsd upgrade` in the TUI and the web UI's Update button.
# One body defines both names and funcstack gives the name it was called
# by ($0 is the script name when the caller emulates sh). No `_` helper,
# because Claude Code's shell snapshot drops `_` functions.
gsd gsd-cli() {
  emulate -L zsh
  local bin=${funcstack[1]}
  case "$1" in
    update|upgrade)
      if [[ "$2" != "--models" ]]; then
        print -u2 "$bin $1: blocked; gsd is pinned by mise."
        print -u2 "Bump version in the chezmoi source of ~/.config/mise/config.toml, then run:"
        print -u2 "  chezmoi apply ~/.config/mise/config.toml && mise install npm:@opengsd/gsd-pi && gsd list"
        return 1
      fi
      ;;
  esac
  command "$bin" "$@"
}

# --------------------------------------------
# npm Global Uninstall Cleanup
# --------------------------------------------
# npm prunes a scope directory emptied by an uninstall only under
# install-strategy=linked, which global installs never use, so
# `npm uninstall -g @scope/pkg` leaves an empty @scope behind in the
# global root. Remove such directories after a successful global
# uninstall. Only interactive zsh has this function: scripts, `zsh -c`
# and `mise exec ... -- npm` run npm directly.
npm() {
  emulate -L zsh
  command npm "$@"
  local exit_code=$?
  (( exit_code == 0 )) || return $exit_code

  # Global as npm decides it: the -g flag (last one wins) or --location=global
  local arg prev cmd gflag location prefix
  for arg in "$@"; do
    case "$prev" in
      --location|-L) location=$arg; prev=; continue ;;
      --prefix|-C) prefix=$arg; prev=; continue ;;
    esac
    case "$arg" in
      --dry-run|--dry-run=true|-h|-H|'-?'|--help|--usage|-v|--version)
        return $exit_code ;;
      -g|--global|--global=true) gflag=1 ;;
      --local|--no-global|--global=false) gflag= ;;
      --location=*|-L=*) location=${arg#*=} ;;
      --prefix=*) prefix=${arg#*=} ;;
      -*) ;;
      *) [[ -z "$cmd" ]] && cmd=$arg ;;
    esac
    prev=$arg
  done
  [[ -n "$gflag" || "$location" == global ]] || return $exit_code

  # Every abbreviation npm resolves to uninstall (lib/utils/cmd-list.js)
  case "$cmd" in
    un|uni|unin|unins|uninst|uninsta|uninstal|uninstall) ;;
    unl|unli|unlin|unlink|r|rm|rem|remo|remov|remove) ;;
    *) return $exit_code ;;
  esac

  local -a root_args=(root -g)
  [[ -n "$prefix" ]] && root_args+=(--prefix "$prefix")
  local root scope_dir
  root=$(command npm "${root_args[@]}") || return $exit_code
  [[ "$root" == /?* ]] || return $exit_code
  # (N/^F): directories that are empty; rmdir refuses anything else
  for scope_dir in "$root"/@*(N/^F); do
    rmdir -- "$scope_dir" && print -u2 "Removed empty scope directory: $scope_dir"
  done
  return $exit_code
}

# --------------------------------------------
# Google Cloud SDK
# --------------------------------------------
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# --------------------------------------------
# Plugins & Widgets
# --------------------------------------------
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  [[ -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
    source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

function peco-select-history() {
    BUFFER=$(fc -l -n 1 | tail -r | awk '!a[$0]++' | peco --query "$LBUFFER")
    CURSOR=${#BUFFER}
}

if command -v peco &>/dev/null; then
    zle -N peco-select-history
    bindkey '^R' peco-select-history
fi

# zsh-syntax-highlighting must be sourced after all ZLE widget definitions
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  [[ -f "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
    source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# --------------------------------------------
# mise & Prompt
# --------------------------------------------
command -v mise &>/dev/null && eval "$(mise activate zsh)"

if [[ -o interactive && "${TERM:-}" != "dumb" ]] && command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
